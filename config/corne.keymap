#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        lthp: lthp {
            compatible = "zmk,behavior-hold-tap";
            label = "Layer/Tap Hold Preferred";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";
            bindings = <
&kp TAB    &kp Q  &kp W  &kp E     &kp R                   &kp T           &kp Y              &kp U      &kp I            &kp O    &kp P     &kp DELETE
&kp LALT   &kp A  &kp S  &kp D     &kp F                   &kp G           &kp H              &kp J      &kp K            &kp L    &kp SQT   &kp RIGHT_ALT
&kp LSHFT  &kp Z  &kp X  &kp C     &kp V                   &kp B           &kp N              &kp M      &kp COMMA        &kp DOT  &kp FSLH  &mo 3
                         &kp LGUI  &mt LEFT_CONTROL ENTER  &lthp 1 SEMI    &lthp 2 BACKSPACE  &kp SPACE  &kp RIGHT_SHIFT
            >;
        };

        lower_layer {
            display-name = "NUMBER";
            bindings = <
&trans  &kp EXCLAMATION  &kp AT_SIGN  &kp POUND  &kp DOLLAR        &kp PERCENT       &kp CARET        &kp AMPERSAND      &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp MINUS
&trans  &kp N1           &kp N2       &kp N3     &kp N4            &kp N5            &kp N6           &kp N7             &kp N8        &kp N9                &kp N0                 &trans
&trans  &trans           &kp TILDE    &kp GRAVE  &kp LEFT_BRACKET  &kp LEFT_BRACE    &kp RIGHT_BRACE  &kp RIGHT_BRACKET  &trans        &trans                &kp LEFT_WIN           &trans
                                      &trans     &trans            &trans            &kp BACKSPACE    &kp SPACE          &kp LCTRL
            >;
        };

        raise_layer {
            display-name = "SYMBOL";
            bindings = <
&trans  &kp DELETE     &trans       &kp UNDERSCORE  &kp PLUS     &kp LESS_THAN       &trans    &trans    &trans  &kp BACKSLASH  &kp PIPE    &trans
&trans  &none          &none        &kp MINUS       &kp EQUAL    &kp GREATER_THAN    &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT      &kp K_MENU  &trans
&trans  &kp PAGE_DOWN  &kp PAGE_UP  &kp K_COPY      &kp K_PASTE  &kp SEMICOLON       &trans    &trans    &trans  &trans         &trans      &trans
                                    &kp LEFT_META   &kp ESCAPE   &kp SPACE           &trans    &trans    &trans
            >;
        };

        layer_3 {
            display-name = "CTRL";
            bindings = <
&bt BT_CLR  &kp F1        &kp F2        &kp F3        &kp F4        &kp F5             &kp F6         &kp F7        &kp F8      &kp F9   &kp F10  &trans
&kp CAPS    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4       &kp C_VOL_DN   &kp C_VOL_UP  &kp C_PLAY  &kp F11  &kp F12  &trans
&trans      &trans        &trans        &trans        &trans        &trans             &kp C_BRI_DEC  &kp C_BRI_UP  &trans      &trans   &trans   &kp PRINTSCREEN
                                        &kp LCTRL     &kp ENTER     &kp PRINTSCREEN    &kp BSPC       &kp SPACE     &kp RSHFT
            >;
        };
    };
};
