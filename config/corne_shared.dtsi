/*
 * Shared Corne layout: the 42 keys every Corne has.
 *
 * Edit keys HERE and both keyboards get the change.
 *   - config/corne.keymap         -> classic 42-key Corne (nice!nano)
 *   - config/eyelash_corne.keymap -> Eyelash Corne (adds joystick + knob keys)
 *
 * Each layer is split into rows so a keyboard with extra keys can slot them
 * in between the halves:
 *   <NAME>_L0 / _R0   top row       (left 6 / right 6)
 *   <NAME>_L1 / _R1   home row
 *   <NAME>_L2 / _R2   bottom row
 *   <NAME>_LT / _RT   thumbs        (left 3 / right 3)
 *
 * Before including this file, a keymap must define:
 *   COMBO_THUMB_LEFT_OUTER, COMBO_THUMB_LEFT_INNER,
 *   COMBO_THUMB_RIGHT_INNER, COMBO_THUMB_RIGHT_OUTER   (key positions)
 * and may define HAS_RGB if the board has RGB underglow.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define L_QWERTY 0
#define L_NUMBER 1
#define L_SYMBOL 2
#define L_CTRL   3

/* ---------------------------------------------------------------- QWERTY */
#define QWERTY_L0 &kp TAB    &kp Q  &kp W  &kp E     &kp R                   &kp T
#define QWERTY_R0 &kp Y      &kp U  &kp I  &kp O     &kp P                   &kp DELETE
#define QWERTY_L1 &kp LALT   &kp A  &kp S  &kp D     &kp F                   &kp G
#define QWERTY_R1 &kp H      &kp J  &kp K  &kp L     &kp SQT                 &kp RIGHT_ALT
#define QWERTY_L2 &kp LSHFT  &kp Z  &kp X  &kp C     &kp V                   &kp B
#define QWERTY_R2 &kp N      &kp M  &kp COMMA &kp DOT &kp FSLH               &mo L_CTRL
#define QWERTY_LT                          &kp LGUI  &mt LEFT_CONTROL ENTER  &lthp L_NUMBER SEMI
#define QWERTY_RT &lthp L_SYMBOL BACKSPACE  &kp SPACE  &kp RIGHT_SHIFT

/* ---------------------------------------------------------------- NUMBER */
#define NUMBER_L0 &trans  &kp EXCLAMATION  &kp AT_SIGN  &kp POUND  &kp DOLLAR        &kp PERCENT
#define NUMBER_R0 &kp CARET  &kp AMPERSAND  &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp MINUS
#define NUMBER_L1 &trans  &kp N1           &kp N2       &kp N3     &kp N4            &kp N5
#define NUMBER_R1 &kp N6     &kp N7         &kp N8        &kp N9                &kp N0                 &trans
#define NUMBER_L2 &trans  &trans           &kp TILDE    &kp GRAVE  &kp LEFT_BRACKET  &kp LEFT_BRACE
#define NUMBER_R2 &kp RIGHT_BRACE  &kp RIGHT_BRACKET  &trans  &trans        &kp LEFT_WIN           &trans
#define NUMBER_LT                                       &trans     &trans            &trans
#define NUMBER_RT &kp BACKSPACE  &kp SPACE  &kp LCTRL

/* ---------------------------------------------------------------- SYMBOL */
#define SYMBOL_L0 &trans  &kp DELETE     &trans       &kp UNDERSCORE  &kp PLUS    &kp LESS_THAN
#define SYMBOL_R0 &trans    &trans    &trans  &kp BACKSLASH  &kp PIPE    &trans
#define SYMBOL_L1 &trans  &none          &none        &kp MINUS       &kp EQUAL   &kp GREATER_THAN
#define SYMBOL_R1 &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT      &kp K_MENU  &trans
#define SYMBOL_L2 &trans  &kp PAGE_DOWN  &kp PAGE_UP  &trans          &trans      &kp SEMICOLON
#define SYMBOL_R2 &trans    &trans    &trans  &trans         &trans      &trans
#define SYMBOL_LT                                     &kp LEFT_META   &kp ESCAPE  &kp SPACE
#define SYMBOL_RT &trans    &trans    &trans

/* ------------------------------------------------------------------ CTRL */
#define CTRL_L0 &bt BT_CLR  &kp F1        &kp F2        &kp F3        &kp F4        &kp F5
#define CTRL_R0 &kp F6         &kp F7        &kp F8        &kp F9   &kp F10  &trans
#define CTRL_L1 &kp CAPS    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
#define CTRL_R1 &kp C_VOL_DN   &kp C_PLAY    &kp C_VOL_UP  &kp F11  &kp F12  &trans
#ifdef HAS_RGB
#define CTRL_L2 &trans      &rgb_ug RGB_ON  &rgb_ug RGB_OFF  &rgb_ug RGB_BRI  &rgb_ug RGB_BRD  &rgb_ug RGB_EFF
#else
#define CTRL_L2 &trans      &trans        &trans        &trans        &trans        &trans
#endif
#define CTRL_R2 &kp C_BRI_DEC  &kp C_BRI_UP  &trans        &trans   &trans   &kp PRINTSCREEN
#define CTRL_LT                                 &kp LCTRL     &kp ENTER     &kp PRINTSCREEN
#define CTRL_RT &kp BSPC       &kp SPACE     &kp RSHFT

/ {
    behaviors {
        lthp: lthp {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Layer/Tap Hold Preferred";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    macros {
        workspaces_work: workspaces_work {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(N3) &kp LA(N2) &kp C_STOP>;
            wait-ms = <50>;
            tap-ms = <50>;
        };

        workspaces_fun: workspaces_fun {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(N6) &kp LA(N5)>;
            wait-ms = <50>;
            tap-ms = <50>;
        };
    };

    combos {
        compatible = "zmk,combos";

        /* both inner thumbs */
        workspaces_work {
            bindings = <&workspaces_work>;
            key-positions = <COMBO_THUMB_LEFT_INNER COMBO_THUMB_RIGHT_INNER>;
        };

        /* both outer thumbs */
        workspaces_fun {
            bindings = <&workspaces_fun>;
            key-positions = <COMBO_THUMB_LEFT_OUTER COMBO_THUMB_RIGHT_OUTER>;
        };
    };
};
